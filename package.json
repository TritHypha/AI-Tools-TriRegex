{
  "name": "triregex",
  "version": "0.5.0",
  "description": "Ternary streaming pattern matching for a supported subset: non-backtracking and bounded by a compile-time cost certificate, with fail-closed refusal for unsupported or over-budget patterns. Three-valued streaming verdicts (+1 match / 0 indeterminate / -1 refuse) with fail-closed collapse at end-of-stream.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TritHypha/AI-Tools-TriRegex.git"
  },
  "homepage": "https://github.com/TritHypha/AI-Tools-TriRegex#readme",
  "bugs": {
    "url": "https://github.com/TritHypha/AI-Tools-TriRegex/issues"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "AUDIT.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "check:release": "node tools/release-check.mjs"
  },
  "keywords": [
    "regex",
    "redos",
    "streaming",
    "automaton",
    "non-backtracking",
    "ternary",
    "security",
    "fail-closed",
    "linear-time"
  ],
  "author": "TritHypha <hello@trithypha.dev>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
